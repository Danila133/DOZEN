# ── Local / Vercel ──

# Required — canonical URLs (Farcaster manifest, OG, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel production: NEXT_PUBLIC_SITE_URL=https://dozen-tau.vercel.app

# Preview mode: mock data when Hub is not deployed (default on if Hub address is zero)
NEXT_PUBLIC_PREVIEW_MODE=true

# Required — leaderboard + referrals API (Alchemy, Infura, etc.)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Required for rank badge mint API (must match BadgeNFT.rankSigner on-chain)
BADGE_RANK_SIGNER_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Optional — faster leaderboard indexing after Hub deploy
# HUB_DEPLOY_FROM_BLOCK=0

# Optional — override builder code (see src/config/app.ts)
# NEXT_PUBLIC_BASE_BUILDER_CODE=

# ── Local deploy only (never commit) ──
# PRIVATE_KEY=0x...
# RANK_SIGNER=0x...
# Basescan / Etherscan API V2 (contract verify): https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=...
